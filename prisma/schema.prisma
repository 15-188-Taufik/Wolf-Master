// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id          String   @id @default(cuid())
  name        String?  // [BARU] Nama sesi game
  createdAt   DateTime @default(now())
  status      String   @default("SETUP")
  currentTurn Int      @default(0)
  players     Player[]
  logs        Log[]
}

model Role {
  id            String   @id
  name          String
  alignment     String
  description   String
  nightPriority Int
  players       Player[]
}

model Player {
  id               String   @id @default(cuid())
  nickname         String
  isAlive          Boolean  @default(true)
  roleId           String
  role             Role     @relation(fields: [roleId], references: [id])
  currentAlignment String 
  effects          String[]
  linkedToId       String?
  parentId         String?
  gameId           String
  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade) // [BARU] onDelete Cascade
  createdAt        DateTime @default(now())

  // [BARU] Mencegah nama kembar dalam satu game
  @@unique([gameId, nickname]) 
}

model Log {
  id          String   @id @default(cuid())
  turnNumber  Int
  phase       String
  message     String
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model MasterPlayer {
  id        String   @id @default(cuid())
  nickname  String   @unique
  createdAt DateTime @default(now())
}